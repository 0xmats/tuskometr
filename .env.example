# Public stream used by the experimental YouTube adapter.
SOURCE_MODE=youtube
SOURCE_URL=https://www.youtube.com/watch?v=dzntyCTgJMQ

# Storage and retention.
DATABASE_URL=sqlite:////data/tuskometr.db
TRANSCRIPT_RETENTION_DAYS=30
APP_TIMEZONE=Europe/Warsaw

# Transcription provider: local or ovh. Recreate the worker after changing.
ASR_PROVIDER=local
# Required only for ovh. Keep the key on the server, never in frontend code.
ASR_API_KEY=
ASR_API_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
ASR_API_MODEL=whisper-large-v3-turbo
ASR_API_TIMEOUT_SECONDS=60

# Local faster-whisper settings (ignored by the OVH provider).
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=4
ASR_BEAM_SIZE=3
ASR_FALLBACK_MODEL=base
ASR_HOTWORDS_VERIFY=true

# 25-second windows with 5 seconds of overlap.
CHUNK_SECONDS=25
CHUNK_STEP_SECONDS=20
SAMPLE_RATE=16000
MAX_AUDIO_QUEUE_SECONDS=90

# Optional HTTP proxy for anonymous YouTube metadata and audio over Tailscale.
YOUTUBE_PROXY_URL=

# Frontend-only development uses local dev/dashboard.json fixtures by default.
# Optional: https://data.tuskometr.com to preview published production JSON.
TUSKOMETR_DATA_ORIGIN=

# Web process.
FRONTEND_DIST=/app/static
# Check for new mentions/status transitions every 5 seconds.
DASHBOARD_REFRESH_SECONDS=5
# Refresh status timestamps and rolling charts even when no mentions change.
DASHBOARD_PUBLISH_INTERVAL_SECONDS=60
DASHBOARD_MAX_STALE_SECONDS=120
DASHBOARD_RETENTION_SECONDS=900
# Standalone publisher output (Compose uses its shared /snapshots volume).
DASHBOARD_OUTPUT_DIR=/snapshots

# Production R2 publisher (docker-compose.prod.yml).
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=tuskometr-public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Keep unreferenced objects for 24h; active objects never expire automatically.
R2_RETENTION_SECONDS=86400

# Resume YouTube audio from persisted progress within its DVR window.
YOUTUBE_DVR_ENABLED=true
YOUTUBE_DVR_HOURS=12

# Optional Healthchecks ping URLs. Leave empty to disable monitoring.
HEALTHCHECKS_COLLECTING_URL=
HEALTHCHECKS_PUBLISHING_URL=
HEALTHCHECKS_BACKUP_URL=

# Larger ASR requests for existing DVR backlog; live windows still use CHUNK_SECONDS.
YOUTUBE_DVR_CATCHUP_CHUNK_SECONDS=300

# Fill all missing transcript ranges in the available DVR window, including older gaps.
YOUTUBE_HISTORY_ENABLED=true
