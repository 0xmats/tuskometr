{
    admin off
    auto_https off
}

:8080 {
    encode gzip
    handle /healthz {
        header Cache-Control "no-store"
        respond "ok" 200
    }
    handle /dashboard/manifest.json {
        root * /snapshots
        uri strip_prefix /dashboard
        header Cache-Control "public, max-age=5, must-revalidate"
        file_server
    }
    @version path_regexp version ^/dashboard/versions/[a-f0-9]{32}/(1|7|30)-[0-9]+\.json$
    handle @version {
        root * /snapshots
        uri strip_prefix /dashboard
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @reserved path /dashboard /dashboard/* /api /api/*
    handle @reserved {
        error 404
    }
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
    handle_errors {
        header Cache-Control "no-store"
        respond "Data unavailable" {err.status_code}
    }
}
