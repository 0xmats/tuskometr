# Dedicated PRIVATE bucket, never the dashboard's public R2 bucket.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/tuskometr-backups/production
RESTIC_PASSWORD=replace-with-a-long-random-password
AWS_ACCESS_KEY_ID=replace-with-backup-bucket-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-bucket-secret-key
AWS_DEFAULT_REGION=auto
# Stable across container/server replacements; use staging for a separate environment.
BACKUP_RESTIC_HOST=tuskometr-production
BACKUP_RESTIC_KEEP_LAST=10
BACKUP_RESTIC_KEEP_DAILY=14
BACKUP_RESTIC_KEEP_WEEKLY=8
